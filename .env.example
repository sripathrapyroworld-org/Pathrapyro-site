# Database — Neon Postgres (use **pooled** connection string on Netlify)
# Example: postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/pathrapyro?sslmode=require
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/pathrapyro?sslmode=require"

# Auth (NextAuth v5)
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
AUTH_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Google Sign-In + One Tap (customer login)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000, https://yourdomain.com
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google, https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Razorpay — use test keys locally; live keys in production.
# Leave as placeholder values to enable demo checkout (no real payment).
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"

# Supabase Storage (required on Netlify — create a public bucket named "uploads")
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="uploads"
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="uploads"

# Seed (first deploy only — run `npm run db:seed` once after db push)
ADMIN_EMAIL="admin@pathrapyro.local"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="Selva Murugan"
ADMIN_PHONE="9843211234"

# Local dev without Supabase: omit SUPABASE_* vars — files save to ./uploads/
